# GonkaRouter API Key (https://gonkarouter.io)
# If left unset, the backend will attempt to read GONKA_API_KEY from local.properties.
GONKA_API_KEY=sk-xxxxxx
GONKA_BASE_URL=https://api.gonkarouter.io

# Comma-separated. Only needed when the frontend is not served through the Vite
# dev proxy (which forwards /api and /models, so no cross-origin request occurs).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
